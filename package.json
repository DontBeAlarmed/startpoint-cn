{
  "name": "starpoint-cn",
  "version": "1.0.1",
  "description": "世界弹射物语(World Flipper)CN(雷霆)版本服务端模拟器",
  "main": "server.ts",
  "scripts": {
    "build": "npm run build:legacy && npm run css",
    "typecheck": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit",
    "build:server": "node tools/test-workflow/build-cn.cjs",
    "build:bundle": "npm run build:server && node tools/server-bundle/build.cjs",
    "build:legacy": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc -p tsconfig.json",
    "css": "npx tailwindcss -i ./src/input.css -o ./web/public/tailwind.css",
    "css:watch": "npx tailwindcss -i ./src/input.css -o ./web/public/tailwind.css --watch --poll",
    "dev": "npm run build && node --env-file=.env out/server.js",
    "cdn": "npm run build:legacy && node --env-file=.env out/validate_cdn.js",
    "unzip": "npm run build:legacy && node --env-file=.env out/unzip_cdn.js",
    "debug": "npm run css && npm run css:watch & npm run debug:ts-only",
    "debug:ts-only": "tsnd --inspect -- src/server.ts",
    "start:cn": "node tools/start_cn.cjs",
    "dev:cn": "npm run build:server && node tools/start_cn.cjs",
    "debug:cn": "tsnd --env-file=.env -- src/cn-server.ts",
    "cdn:manifest": "node tools/generate_cdn_runtime_manifest.cjs",
    "content:sync": "node tools/content_sync.cjs",
    "content:audit": "node tools/content_asset_audit.cjs",
    "content:smoke": "node tools/content_sync_smoke.cjs",
    "content:mission-event-rules": "node scripts/gen_mission_event_battle_rules.js",
    "content:pass": "node scripts/gen_pass_mission_data.js",
    "content:active-mission": "node scripts/gen_active_mission_data.js",
    "verify:bundle": "node tools/server-bundle/verify.cjs",
    "install:admin": "npm --prefix admin ci",
    "build:admin": "npm --prefix admin run build",
    "dev:admin": "cd admin && npm run dev",
    "test:quick": "node tools/test-workflow/run.cjs --group quick",
    "test:changed": "node tools/test-workflow/run.cjs --changed",
    "test:integration": "node tools/test-workflow/run.cjs --group integration",
    "test:full": "node tools/test-workflow/run.cjs --group full",
    "benchmark:workflow": "node tools/test-workflow/benchmark.cjs",
    "docs:check": "node tools/docs_check.cjs",
    "hygiene": "bash scripts/check-hygiene.sh --all",
    "verify:full": "npm run typecheck && npm run docs:check && npm run test:full && npm run hygiene && npm run build:server"
  },
  "author": "",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.10",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^20.14.2",
    "@types/readline-sync": "^1.4.8",
    "@types/unzipper": "^0.10.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.3.0",
    "cli-progress": "^3.12.0",
    "fastify": "^5.0.0",
    "msgpackr": "^1.11.0",
    "readline-sync": "^1.4.10",
    "tailwindcss": "^3.2.0",
    "unzipper": "^0.12.3"
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
