{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startpoint-cn.local/schemas/character-pack-v1.schema.json",
  "title": "World Flipper CN character package manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "character_id",
    "code_name",
    "package_version",
    "requires_client_base",
    "required_capabilities",
    "roots",
    "tables",
    "skills",
    "unique_condition",
    "qa",
    "snapshot"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "character_id": {
      "type": "integer",
      "minimum": 0
    },
    "code_name": {
      "type": "string",
      "minLength": 1
    },
    "package_version": {
      "type": "string",
      "minLength": 1
    },
    "requires_client_base": {
      "type": "string",
      "minLength": 1
    },
    "required_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["common", "medium", "android", "server"],
      "properties": {
        "common": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["logical_path", "sha256", "size"],
            "properties": {
              "logical_path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$)).+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "medium": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["logical_path", "sha256", "size"],
            "properties": {
              "logical_path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$)).+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "android": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["logical_path", "sha256", "size"],
            "properties": {
              "logical_path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$)).+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "server": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["logical_path", "sha256", "size"],
            "properties": {
              "logical_path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$)).+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "tables": {
      "type": "array"
    },
    "skills": {
      "type": "object"
    },
    "unique_condition": {
      "type": "object"
    },
    "qa": {
      "type": "object"
    },
    "snapshot": {
      "type": "object"
    }
  }
}
